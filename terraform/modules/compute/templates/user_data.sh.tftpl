#!/bin/bash
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

%{ if container_image != "" ~}
docker run -d --name cloudrescue --restart unless-stopped \
  -p ${app_port}:8000 \
  -e CLOUDRESCUE_ENV=${environment} \
  -e CLOUDRESCUE_DEMO_ENDPOINTS_ENABLED=false \
  --log-driver=awslogs \
  --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group_name} \
  --log-opt awslogs-create-group=false \
  ${container_image}
%{ else ~}
echo "No container_image configured: Docker is installed, no application container started."
%{ endif ~}
