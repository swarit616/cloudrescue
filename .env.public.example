# CloudRescue public demonstration configuration
# No AWS credentials or infrastructure access.

CLOUDRESCUE_ENV=demo
CLOUDRESCUE_LOG_LEVEL=INFO

# Public visitors can access read-only endpoints.
# Simulation actions require a secret token.
CLOUDRESCUE_DEMO_ENDPOINTS_ENABLED=true

# Set a strong secret in the hosting provider's environment settings.
# Never commit the actual token to GitHub.
CLOUDRESCUE_DEMO_TOKEN=REPLACE_WITH_SECRET

CLOUDRESCUE_AWS_REGION=
CLOUDRESCUE_AWS_INSTANCE_ID=
