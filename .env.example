# Copy to .env if you want to change defaults:  cp .env.example .env
# Placeholders only. Never put credentials here; this phase needs none.

CLOUDRESCUE_ENV=local
CLOUDRESCUE_LOG_LEVEL=INFO

# Demo endpoints change in-memory state only. Set to false (or set a token) before any public deployment.
CLOUDRESCUE_DEMO_ENDPOINTS_ENABLED=true
# Optional shared secret; when set, demo endpoints require the X-Demo-Token header.
CLOUDRESCUE_DEMO_TOKEN=

# Future AWS target (describes only; NO AWS calls are made in this phase).
# GET /api/status reports aws.configured=true only when BOTH are set.
CLOUDRESCUE_AWS_REGION=
CLOUDRESCUE_AWS_INSTANCE_ID=

# Docker Compose host ports (change if 8000/9090 are used, e.g. by CloudOps360)
CLOUDRESCUE_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9090
